APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1
PUBLIC_DIRECTORY=public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rfid_attendance
DB_USERNAME=rfid_app
DB_PASSWORD=change-me

# Absolute path OUTSIDE public_html; FCM is transport only, never the database.
FCM_SERVICE_ACCOUNT_FILE=
# Public Firebase web app settings and public VAPID key; never a service account.
FCM_WEB_CONFIG_FILE=
